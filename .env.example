# ---- 默认教师登录账号；部署后请尽快修改默认密码 ----
EDU_TEACHER_USER=teacher
EDU_TEACHER_PASS=Zhiyi@2026
EDU_API_HOST=127.0.0.1
EDU_API_PORT=8700

# ---- LLM 配置（二选一） ----
# 方式 A：OpenAI 官方
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-4o-mini

# 方式 B：OpenAI 兼容接口（国内模型如 Ark / DeepSeek / DashScope 均可）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL=deepseek-chat

# ---- Agent 配置 ----
# 允许的文件扩展名（白名单）
ALLOWED_EXT=.xlsx,.xls,.csv
# 单次工具调用返回的最大行数（避免 prompt 爆炸）
MAX_ROWS_IN_CONTEXT=120
# 是否在数据质量失败时中止（true 表示绝不静默降级）
STRICT_DATA_GATE=true
# 上传文件临时目录
UPLOAD_DIR=.data/uploads

# 备份默认包含数据库、上传、导出及 PROJECT_DIR（默认 projects）。
# 自定义课程目录必须明确授权；不要填写用户主目录或含密钥的目录。
# 多个绝对目录：Windows 用分号分隔，Linux/macOS 用冒号分隔。
BACKUP_EXTRA_DIRS=

# ---- 智谱文件解析（PDF / Word / PPT / 图片 / Markdown → 正文） ----
# 在 https://bigmodel.cn/usercenter/proj-mgmt/apikeys 获取
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# lite（免费，常见办公文档）/ expert（仅 PDF，精度高）/ prime（复杂版式）
PARSER_TOOL_TYPE=lite
PARSER_MAX_WAIT=300
PARSER_POLL_INTERVAL=3
# 交给智谱解析的扩展名
DOC_EXT=.pdf,.docx,.doc,.pptx,.ppt,.md,.txt,.html,.htm,.png,.jpg,.jpeg
